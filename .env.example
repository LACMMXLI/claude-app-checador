# ─── Copiar a .env (o cargar en Coolify → Environment Variables). NUNCA subir .env al repositorio. ───
# Usar contraseñas SIN caracteres especiales de URL (p. ej. `openssl rand -hex 24`).

POSTGRES_DB=checador
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar-superusuario        # superusuario: solo lo usan `db` y el paso `init` (bootstrap de roles)

# Contraseñas de los roles de PostgreSQL (las crea el bootstrap)
MIGRATOR_PASSWORD=cambiar-migrator            # dueño de objetos / migraciones (NOBYPASSRLS)
APP_USER_PASSWORD=cambiar-app-user            # la API (NOBYPASSRLS, sin DELETE en datos de negocio)
PLATFORM_OPS_PASSWORD=cambiar-platform-ops    # CLI de plataforma (BYPASSRLS): NO se inyecta en la API

# Secreto del hash de PIN (≥ 32 caracteres, fuera de la BD). Si se pierde o cambia, TODOS los PIN dejan de servir.
PIN_PEPPER=cambiar-por-un-secreto-largo-de-minimo-32-caracteres

# Aplicación
PORT=3000
# Cookies de sesión y de kiosco con `Secure` (__Host-sid / __Host-kiosk). Dejar en true: el panel se sirve por HTTPS.
COOKIE_SECURE=true

# Asistencia: reconciliación automática DENTRO de la API cada N segundos (0 = apagada).
# Alternativa equivalente: tarea programada de Coolify que ejecute `node dist/src/cli/reconcile.js` en el contenedor `api`.
RECONCILE_INTERVAL_SEC=0
