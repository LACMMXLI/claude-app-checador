{
  "name": "@checador/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "db:bootstrap": "tsx src/cli/bootstrap.ts",
    "db:migrate": "tsx src/cli/migrate.ts",
    "check:tenancy": "tsx src/cli/check-tenancy.ts",
    "platform": "tsx src/cli/platform.ts",
    "reconcile": "tsx src/cli/reconcile.ts",
    "start:prod:init": "node dist/src/cli/bootstrap.js && node dist/src/cli/migrate.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
